# ---- Server ----
PORT=4000
LOG_LEVEL=info
MONGO_URI=mongodb://localhost:27017/paperbot
# Comma-separated list when the dashboard is also hosted elsewhere, e.g.
# CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth (one admin user) ----
# Generate the hash with: npm run hash-password -w server -- "your-password"
# Wrap it in single quotes: bcrypt hashes contain $ characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---- Data quality ----
# Ignore any tick that moves more than this % from the previous tick
MAX_TICK_JUMP_PCT=10

# ---- Crypto (CCXT public data, no keys needed) ----
CRYPTO_EXCHANGES=binance,kraken
CRYPTO_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# ---- US stocks (Alpaca market data, free paper account) ----
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
US_SYMBOLS=AAPL,MSFT,SPY

# ---- India (NSE/BSE) ----
# INDIA_BROKER: yahoo (delayed, free) | kite | upstox | angel
INDIA_BROKER=yahoo
KITE_API_KEY=
KITE_ACCESS_TOKEN=
INDIA_SYMBOLS=RELIANCE,TCS,INFY

# ---- Fallback / other markets (yahoo-finance2, delayed, unofficial) ----
# The global wallet is in USD, so use USD-quoted symbols (futures, FX vs USD, ADRs)
GLOBAL_SYMBOLS=GC=F,CL=F,EURUSD=X

# ---- Docker ----
# Host port for the Mongo container when 27017 is already in use
# MONGO_HOST_PORT=27017
